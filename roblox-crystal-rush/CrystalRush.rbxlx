local boostText = label({
	Text = "⭐ 0 Rebirths",
	Size = UDim2.new(1, -20, 0.62, 0),
	Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Parent = boostPill,
})

-- Menu buttons (2 rows of 2)
