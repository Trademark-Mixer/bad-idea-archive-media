{
  "name": "CrystalRush",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "GameShared": {
        "$path": "src/shared/GameShared.luau"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": {
        "$path": "src/server/Main.server.luau"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client/Client.client.luau"
        }
      },
      "$properties": {
        "EnableMouseLockOption": false
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.2,
        "Brightness": 2.6,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true,
          "GrassLength": 0.25
        }
      }
    }
  }
}
